import subprocess #connects os with python
import sys     #
import warnings
warnings.filterwarnings('ignore')

def install_packages():

    packages = ['ipywidgets', 'plotly', 'pandas', 'numpy']
    for package in packages:
        subprocess.check_call([sys.executable, "-m", "pip", "install",
                             "--quiet", package], stdout=subprocess.DEVNULL)

install_packages()

