        elif results['yield_unit'] == 'quintals':
            yield_display = f"{results['yield']:.2f} quintals"
            price_display = f"₹{crop_info['price_per_quintal']}/quintal"
        else:  # tons
            yield_display = f"{results['yield']:.3f} tons"
            price_per_ton = crop_info['price_per_quintal'] * 10  # 1 ton = 10 quintals
            price_display = f"₹{price_per_ton:,.0f}/ton"

        report = f"""
        <div style='background-color:white; padding:20px; border-radius:10px; margin:10px 0; border:3px solid #2c3e50;'>
        <h3 style='color:#2c3e50; background:white; padding:10px; border-radius:5px;'>📊 Crop Analysis Report</h3>
        <hr style='border:2px solid #2c3e50'>
        <div style='display:grid; grid-template-columns:1fr 1fr; gap:15px;'>
            <div style='background:#ffffff; padding:15px; border-radius:8px; border:2px solid #2c3e50;'>
                <h4 style='color:#27ae60; background:white;'>🌱 Crop Details</h4>
                <p><strong style='color:#2c3e50; background:white;'>Crop:</strong> <span style='color:#000000; font-weight:bold; background:white;'>{crop_name}</span></p>
                <p><strong style='color:#2c3e50; background:white;'>Area:</strong> <span style='color:#000000; font-weight:bold; background:white;'>{area} {area_unit}</span></p>
                <p><strong style='color:#2c3e50; background:white;'>Season:</strong> <span style='color:#000000; font-weight:bold; background:white;'>{crop_info['season']}</span></p>
                <p><strong style='color:#2c3e50; background:white;'>Growth Period:</strong> <span style='color:#000000; font-weight:bold; background:white;'>{crop_info['growth_days']} days</span></p>
            </div>

            <div style='background:#ffffff; padding:15px; border-radius:8px; border:2px solid #2c3e50;'>
                <h4 style='color:#2980b9; background:white;'>💰 Yield & Revenue</h4>
                <p><strong style='color:#2c3e50; background:white;'>Estimated Yield:</strong> <span style='color:#000000; font-weight:bold; background:white;'>{yield_display}</span></p>
                <p><strong style='color:#2c3e50; background:white;'>Total Yield (kg):</strong> <span style='color:#000000; font-weight:bold; background:white;'>{results['yield_kg']:,.0f} kg</span></p>
