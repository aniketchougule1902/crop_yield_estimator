def create_yield_chart(crop_data, selected_crop):

    crops = list(crop_data.keys())
    yields = [crop_data[c]['yield_per_acre_kg'] for c in crops]


    colors = ['#3498db' if c != selected_crop else '#e74c3c' for c in crops]

    fig = go.Figure(data=[
        go.Bar(
            x=crops,
            y=yields,
            marker_color=colors,
            text=[f"{y:,.0f} kg/acre" for y in yields],
            textposition='auto',
            textfont=dict(color='black', size=14, weight='bold')
        )
    ])

    fig.update_layout(
        title=dict(
            text='📊 Yield Comparison (kg per acre)',
            font=dict(color='black', size=20, weight='bold'),
            x=0.5
        ),
        xaxis=dict(
            title='Crops',
            titlefont=dict(color='black', size=16, weight='bold'),
            tickfont=dict(color='black', size=14, weight='bold'),
            tickangle=45
        ),
        yaxis=dict(
            title='Yield (kg/acre)',
            titlefont=dict(color='black', size=16, weight='bold'),
            tickfont=dict(color='black', size=14, weight='bold')
        ),
        plot_bgcolor='white',
        paper_bgcolor='white',
        height=500,
        showlegend=False,
        bargap=0.3
    )

    # Add border to plot
    fig.update_xaxes(showline=True, linewidth=2, linecolor='black', mirror=True)
    fig.update_yaxes(showline=True, linewidth=2, linecolor='black', mirror=True)

    return fig

def create_resource_chart(water, fertilizer):

    fig = make_subplots(
        rows=1, cols=2,
        subplot_titles=('💧 Water Requirement', '🧪 Fertilizer Requirement'),
        specs=[[{'type': 'pie'}, {'type': 'bar'}]]
    )

    fig.add_trace(
        go.Pie(
            labels=['Water Required', 'Available Rainfall*'],
            values=[water, max(water * 0.3, 100000)],
            hole=.4,
            marker=dict(colors=['#3498db', '#bdc3c7']),
            textinfo='label+percent',
            textfont=dict(color='black', size=14, weight='bold'),
            hoverinfo='label+value+percent',
            textposition='inside'
        ),
        row=1, col=1
    )


    fig.add_trace(
        go.Bar(
            x=['Nitrogen (N)', 'Phosphorus (P)', 'Potassium (K)'],
            y=[fertilizer['N'], fertilizer['P'], fertilizer['K']],
            marker_color=['#e74c3c', '#f39c12', '#27ae60'],
            text=[f"{v:.1f} kg" for v in [fertilizer['N'], fertilizer['P'], fertilizer['K']]],
            textposition='auto',
            textfont=dict(color='black', size=14, weight='bold')
        ),
        row=1, col=2
    )

    fig.update_layout(
        height=500,
        showlegend=True,
        plot_bgcolor='white',
        paper_bgcolor='white',
        font=dict(color='black', size=14, weight='bold'),
        title_font=dict(size=18, weight='bold'),
        legend=dict(
            font=dict(size=14, color='black', weight='bold'),
            bgcolor='white',
            bordercolor='black',
            borderwidth=2
        )
    )

    fig.update_annotations(
        font=dict(color='black', size=16, weight='bold'),
        bgcolor='white'
    )

    # Add borders
    fig.update_xaxes(showline=True, linewidth=2, linecolor='black', mirror=True)
    fig.update_yaxes(showline=True, linewidth=2, linecolor='black', mirror=True)

    return fig

