# %% [code]
# Crop Database Viewer
def show_crop_database():
    """Display crop database in a table"""
    data = []
    for crop, info in db.crops.items():
        data.append({
            'Crop': crop,
            'Yield (kg/acre)': info['yield_per_acre_kg'],
            'Season': info['season'],
            'Growth Days': info['growth_days'],
            'Water (mm)': info['water_requirement_mm'],
            'Price/Quintal': f"₹{info['price_per_quintal']}",
            'Price/kg': f"₹{info['price_per_kg']:.2f}"
        })

    df = pd.DataFrame(data)
    styled_df = df.style.set_properties(**{
        'background-color': 'white',
        'color': 'black',
        'border': '2px solid black',
        'font-weight': 'bold'
    }).set_table_styles([
        {'selector': 'th', 'props': [
            ('background-color', '#2c3e50'),
            ('color', 'white'),
            ('font-weight', 'bold'),
            ('padding', '15px'),
            ('font-size', '16px'),
            ('border', '2px solid black')
        ]},
        {'selector': 'td', 'props': [
            ('padding', '12px'),
            ('border', '2px solid black'),
            ('font-size', '14px')
        ]},
        {'selector': 'tr:hover', 'props': [('background-color', '#e8f4fc')]}
    ])

    return styled_df

# Database display button
db_button = widgets.Button(
    description='📋 VIEW CROP DATABASE',
    button_style='info',
    style={'font_weight': 'bold', 'font_size': '14px'},
    layout={'width': '300px', 'height': '45px', 'margin': '20px', 'border': '3px solid black'}
)

db_output = widgets.Output()

def on_db_click(b):
    with db_output:
        clear_output(wait=True)
        display(HTML("""
        <div style='background: white; padding: 15px; border-radius: 5px; margin: 20px 0;
        border: 3px solid #2c3e50;'>
        <h3 style='color: #2c3e50; background: white; text-align: center;'>📋 CROP DATABASE</h3>
        </div>
        """))
        display(show_crop_database())

db_button.on_click(on_db_click)

# Add database button to UI
display(widgets.VBox([
    db_button,
    db_output
], layout=widgets.Layout(background='white')))
